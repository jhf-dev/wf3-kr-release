{
  "schema": "wind3-release-policy-v1",
  "source_repository": "earlydreamer/wf3-kr-patch",
  "source_default_branch": "main",
  "release_repository": "jhf-dev/wf3-kr-release",
  "release_default_branch": "main",
  "identities": {
    "source_actor": "earlydreamer",
    "source_author_name": "Jaehyun Park",
    "source_author_email": "earlydreamer@users.noreply.github.com",
    "release_actor": "jhf-dev",
    "release_author_name": "jhf-dev",
    "release_author_email": "285839567+jhf-dev@users.noreply.github.com"
  },
  "versioning": {
    "prerelease_pattern": "^[0-9]{8}-v[1-9][0-9]*$",
    "stable_pattern": "^[0-9]{8}-v[1-9][0-9]*-release$",
    "asset_template": "wind3-korean-patch-{version}.zip",
    "stable_suffix": "-release",
    "packaged_artifact_uses_prerelease_base_version": true,
    "reused_version_forbidden": true,
    "semantic_change_requires_new_version": true
  },
  "notes": {
    "baseline_source": "github_latest_stable",
    "title_template": "# 릴리즈 노트 ({version})",
    "package_title_template": "# {version}",
    "required_level2_headings": [
      "다운로드",
      "{baseline_tag} 대비 주요 변경사항"
    ],
    "forbid_additional_level2_headings": true,
    "forbid_other_version_headings": true,
    "forbidden_public_terms": [
      "XLSX",
      "analysis_out",
      "openpyxl",
      "PyInstaller",
      "csc",
      "sealed artifact",
      "build_id",
      "artifact_id"
    ]
  },
  "package": {
    "root_prefix": "wind3_korean_patch/",
    "launcher_version_path": "wind3_korean_patch/launcher_version.json",
    "public_launchers": [
      "Wind3 Korean Patch Launcher.exe",
      "Wind3 Korean Patch Lite Launcher.exe",
      "windconfig.exe"
    ],
    "public_auxiliary_executables": [
      "Wind3 Korean Patch Updater.exe"
    ],
    "runtime_executables": [
      "_runtime/release_runtime_backend.exe"
    ],
    "forbidden_developer_entries": [
      "xlsx_truth_launcher",
      "launch_xlsx_truth_pipeline",
      "openpyxl",
      "tooling/",
      "analysis_out/"
    ],
    "forbidden_developer_extensions": [
      ".xlsx",
      ".xlsm",
      ".py",
      ".pyc",
      ".pdb",
      ".cs",
      ".ps1",
      ".bat",
      ".cmd"
    ]
  },
  "publication": {
    "immutable_releases_required": true,
    "ordinary_remote_mutation": "owner-api-only",
    "first_public_state": "prerelease",
    "prerelease_make_latest": false,
    "stable_make_latest": true,
    "stable_is_separate_release": true,
    "allowed_transitions": [
      "absent->prerelease_draft",
      "prerelease_draft->prerelease",
      "prerelease->stable_draft",
      "stable_draft->stable"
    ],
    "stable_required_proofs": [
      "github_redownload",
      "clean_temp_from_redownload",
      "runtime_user_pr_comment",
      "separate_user_approval_pr_comment"
    ],
    "published_in_place_changes_forbidden": [
      "tag",
      "asset",
      "body",
      "channel"
    ]
  },
  "proofs": {
    "draft_receipt_ttl_hours": 24,
    "stage6_required_gates": [
      "clean_temp_directory",
      "clean_temp_release_zip",
      "game_root_discovery",
      "relocated_launcher_startup",
      "force_victory_marker_closure"
    ]
  },
  "receipts": {
    "schema": "wind3-release-receipt-v2",
    "require_previous_receipt_sha256": true,
    "require_nonce": true,
    "require_created_at": true,
    "exclusive_create": true
  }
}
